{
  "manifest_version": 3,
  "name": "AI-Bridge (Side Panel Edition)",
  "short_name": "AI-Bridge",
  "version": "1.2.2",
  "description": "閲覧中のページのソースコードとスクリーンショットを取得し、サイドパネルのAIチャットへ橋渡しします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://venice.ai/*",
    "https://chat.webllm.ai/*",
    "https://copilot.microsoft.com/*",
    "https://duck.ai/*",
    "https://duckduckgo.com/*",
    "https://huggingface.co/*",
    "https://tongyi.aliyun.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "action": {
    "default_title": "AI-Bridgeを表示"
  }
}
